# SHEHARNAAMA — environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Admin console (server-side authentication) ---
# Choose a username of 3+ characters.
ADMIN_USERNAME=change-me-admin
# Choose a strong password of 8+ characters. Defaults and known-weak values
# are rejected as insecure. Alternatively set ADMIN_PASSWORD_HASH instead
# (sha256 hex digest of the password) and leave ADMIN_PASSWORD empty.
ADMIN_PASSWORD=change-me-strong-password
# ADMIN_PASSWORD_HASH=

# --- Sessions ---
# Optional: any long random string. If unset, an ephemeral secret is
# generated at startup (admin sessions then do not survive a restart).
SESSION_SECRET=
SESSION_TTL_MINUTES=120

# --- Storage & mode ---
# SQLite database location (relative to the project root or absolute).
# The default data/ directory is NOT publicly served and is git-ignored.
SHEHARNAAMA_DB_PATH=data/sheharnaama.sqlite3
# development | production
ENVIRONMENT=development
# Set true in production (HTTPS) so the admin session cookie is Secure-only.
SECURE_COOKIES=false

REGISTRATION_RATE_LIMIT=10

# --- Groq AI Assistant ("Ask Pune — Read Closer") ---
# Server-side API key for Groq AI responses and summaries.
GROQ_API_KEY=your_groq_api_key_here
# Supported chat model (e.g. llama-3.3-70b-versatile or llama-3.1-8b-instant)
GROQ_MODEL=your_supported_groq_model_name
CHAT_RATE_LIMIT=20